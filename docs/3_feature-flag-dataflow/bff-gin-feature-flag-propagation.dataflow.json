  "nodes": [
    { "id": "admin_go", "type": "backend", "label": "admin/go", "sublabel": ":8091", "stage": 0, "row": 0 },
    { "id": "admin_rails", "type": "backend", "label": "admin/rails", "sublabel": ":8092", "stage": 0, "row": 2 },
    { "id": "mysql", "type": "database", "label": "MySQL", "sublabel": "feature_flags", "stage": 1, "row": 1, "tag": "正本" },
    { "id": "backend", "type": "backend", "label": "backend", "sublabel": "MySQL retriever", "stage": 2, "row": 0 },
