    { "id": "bff-browser", "from": "bff", "to": "browser", "label": "GET /api/me(2フラグのみ公開)", "classification": "frontend向けのみ公開", "variant": "emphasis", "fromSide": "right", "toSide": "left", "labelAt": [638, 428] }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "正本はMySQLの1テーブルのみ",
      "items": [
        "admin/goとadmin/railsは独立した実装だが同じfeature_flagsテーブルを直接操作する",
        "片方で変更しもう片方の画面をリロードするだけで一致する",
        "変更はfeature_flag_audit_logsにも記録される"
      ]
    },
    {
      "dot": "amber",
      "title": "反映は即時ではない",
      "items": [
        "admin変更のMySQLへの書き込み自体は即時",
        "backend・bffともポーリング間隔は固定10秒(環境変数での変更は不可)",
        "そのため反映まで最大10秒程度のラグが生じる"
      ]
    },
    {
      "dot": "rose",
      "title": "ブラウザに届くのはごく一部",
      "items": [
        "bffが評価する8種のうちfrontend.tasks-ts-rewriteとfrontend.task-create-uxの2つだけが/api/me経由でBrowserへ届く",
        "bff.tasks-backend-v2(非推奨)やbackend.task-protocolはbff内部限定でBrowserには渡らない",
        "backend.task-language等は外部公開API・frontend-rails等の別経路向けにbackend自身が評価し、bff・Browserを一切経由しない"
      ]
    }
  ]
}
