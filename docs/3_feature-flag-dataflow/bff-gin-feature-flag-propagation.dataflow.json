  ],
  "flows": [
    { "id": "admin-go-write", "from": "admin_go", "to": "mysql", "label": "UPDATE feature_flags", "classification": "管理操作", "variant": "default", "fromSide": "right", "toSide": "left", "labelAt": [208, 200] },
    { "id": "admin-rails-write", "from": "admin_rails", "to": "mysql", "label": "UPDATE feature_flags(同上)", "classification": "管理操作", "variant": "default", "fromSide": "right", "toSide": "left", "labelDy": 18 },
    { "id": "backend-poll", "from": "mysql", "to": "backend", "label": "定期ポーリング(10秒間隔)", "classification": "正本の読み出し", "variant": "emphasis", "fromSide": "right", "toSide": "left", "labelAt": [423, 200] },
    { "id": "bff-poll", "from": "backend", "to": "bff", "label": "feature-flags/exportをポーリング(10秒間隔)", "classification": "HTTP retrieverポーリング", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "labelAt": [620, 215] },
