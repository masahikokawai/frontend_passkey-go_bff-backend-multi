@startuml c4_container_v2
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title bff-gin コンテナ図 (C4 Level 2)

Person(general_user, "一般ユーザー")
Person(admin_user, "管理者ユーザー")
System_Ext(external_client, "外部APIクライアント", "サーバー間連携。Client Credentials Grantでbackendへ直接アクセス(BFF非経由)")

System_Boundary(bff_gin, "bff-gin") {
  Container(frontend, "frontend", "React (Vite) / TypeScript(tasksのみ)+JS", "SPA。JWTは一切保持しない。HttpOnly Cookie(session_id)のみブラウザに残る")
  Container(bff, "bff", "Go 1.27 / Gin v1.12.0", "唯一の公開窓口。OIDCクライアント、Redisセッション管理、Feature Flag評価、backendへのプロキシ(REST v1 / gRPC v2)")
  Container(backend, "backend", "Go 1.27", "private network限定。REST v1(意図的にN+1を再現した旧実装)とgRPC v2(Preload最適化した新実装)を同一プロセスで提供")
}

System_Ext(keycloak, "Keycloak", "OIDC IdP")
ContainerDb(mysql, "MySQL", "MySQL 8.0 (Docker)", "users/tasks/labels等。utf8mb4")
ContainerDb(redis, "Redis", "Docker", "session:{sessionID} → Access/Refresh/ID Token、lock:session:{sessionID} → 分散ロック")
Container(swagger_ui, "swagger-ui", "Docker (swaggerapi/swagger-ui)", "backend/openapi/external-api.yamlを表示・Try it out")

Rel(general_user, frontend, "操作", "HTTPS")
Rel(admin_user, frontend, "操作", "HTTPS")
Rel(frontend, bff, "REST API呼び出し(Cookie自動送信 + X-CSRF-Token)", "HTTPS/JSON")
Rel(bff, keycloak, "Authorization Code+PKCE / Refresh / RP-Initiated Logout", "OIDC")
Rel(bff, redis, "セッション読み書き・分散ロック", "RESP")
Rel(bff, backend, "Flag=OFF: REST v1 / Flag=ON: gRPC v2\n(Access Tokenをヘッダ/metadataで転送)", "HTTP or gRPC (本番想定: internal-net限定)")
Rel(backend, mysql, "CRUD", "GORM / go-sql-driver/mysql")
Rel(backend, keycloak, "JWKS取得(iss/aud/exp/nbf検証)", "HTTPS")
Rel(external_client, keycloak, "Client Credentials Grant(grant_type=client_credentials)", "OIDC")
Rel(external_client, backend, "GET /external/v1/tasks?user_id=(azp=external-api-clientを検証)\nFlag=OFF: offsetページング / Flag=ON: cursorページング", "HTTPS (:8081、BFF非経由)")
Rel(swagger_ui, backend, "「Try it out」でブラウザから直接呼び出し(swagger-ui自体はbackendへ到達不要)", "HTTPS")

note right of backend
  【現状のローカル開発環境との差異】
  KeycloakのAuthorization Code Flowはブラウザを直接Keycloakへ
  リダイレクトするため、bff/backendをコンテナ化するとコンテナ内部向け
  ホスト名とブラウザが到達できるホスト名が一致せずissuer検証が破綻する。
  そのため現在のdocker-compose.yamlではbff/backendをコンテナ化せず
  ホスト上で直接 `go run` する構成にしており、この図が示す
  internal-netによるネットワーク分離は本番構成の想定であって、
  ローカル開発では実施していない(README参照)。
end note

SHOW_LEGEND()
@enduml
