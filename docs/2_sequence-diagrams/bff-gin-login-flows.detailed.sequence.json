  "cards": [
    {
      "dot": "emerald",
      "title": "BFFパターンと3方式の違い",
      "items": [
        "ブラウザが持つのはHttpOnly Cookie+CSRFトークンのみ、JWTは一切渡らない",
        "HMAC=共有シークレット、RSA=bff自身の鍵、Keycloak=認可コード+PKCE+JITプロビジョニング"
      ]
    }
  ]
}
