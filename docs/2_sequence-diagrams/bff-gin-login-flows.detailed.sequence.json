    { "participant": "keycloak", "from": 631, "to": 668, "type": "security" },
    { "participant": "keycloak", "from": 827, "to": 836, "type": "security" },
    { "participant": "redis", "from": 239, "to": 249, "type": "database" },
    { "participant": "redis", "from": 407, "to": 417, "type": "database" },
    { "participant": "redis", "from": 743, "to": 753, "type": "database" },
