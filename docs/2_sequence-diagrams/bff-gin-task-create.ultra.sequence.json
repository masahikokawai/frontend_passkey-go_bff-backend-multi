    { "id": "grpc-rows", "from": "mysql", "to": "backend_grpc", "y": 417, "label": "rows", "variant": "return" },
    { "id": "grpc-response", "from": "backend_grpc", "to": "bff", "y": 445, "label": "CreateTaskResponse(labelsは1クエリで同梱)", "variant": "return" },
    { "id": "grpc-final", "from": "bff", "to": "browser", "y": 473, "label": "201 Created \"タスクを作成しました\"", "variant": "return" },

    { "id": "err-request", "from": "browser", "to": "bff", "y": 501, "label": "POST /api/tasks (name=21文字超 または finished_onが過去日)", "variant": "emphasis", "note": "bffは未検証のままCreateTask RPCへ転送する" },
    { "id": "err-final", "from": "bff", "to": "browser", "y": 529, "label": "400 Bad Request \"タスク名は20文字以内です\" 等", "variant": "security", "note": "backendがINVALID_ARGUMENTを返し、MySQLへは到達しない" }
