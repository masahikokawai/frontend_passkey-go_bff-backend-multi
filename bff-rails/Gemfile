source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.0.5", ">= 8.0.5.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"
# Build JSON APIs with ease [https://github.com/rails/jbuilder]
# gem "jbuilder"
# Use Redis adapter to run Action Cable in production
# gem "redis", ">= 4.0.1"

# Use Active Model has_secure_password [https://guides.rubyonrails.org/active_model_basics.html#securepassword]
# gem "bcrypt", "~> 3.1.7"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Deploy this application anywhere as a Docker container [https://kamal-deploy.org]
gem "kamal", require: false

# Add HTTP asset caching/compression and X-Sendfile acceleration to Puma [https://github.com/basecamp/thruster/]
gem "thruster", require: false

# Use Rack CORS for handling Cross-Origin Resource Sharing (CORS), making cross-origin Ajax possible
gem "rack-cors"

# CONTRACT.md: frontend-rails/with-bff用の専用BFF
# 既存bff(Go)のRedisセッションと同じ役割
gem "redis", "~> 5.3"

# OIDCハンドシェイクに使うgemをFeature Flag(frontend-rails.oidc-gem)で切り替える比較実装
# omniauth-openid-connectは内部でopenid_connect gemに依存しているが、Rackミドルウェアの
# request_phase/callback_phaseとしてstate/nonce/リダイレクトを自動で扱う「お任せ型」
# openid_connectは同じgemを自分で組み立てて叩く「手組み型」
# 両方とも常時ロードしておき、
# 実行時にどちらの経路を使うかをFeature Flagで切り替える(bff-rails/app/services/auth/参照)
# 【実装時に判明】omniauth-openid-connect(jjbohn版、2020年以降更新停止)はomniauth 1.x系にしか
# 対応しておらず、omniauth 2.x系(omniauth-rails_csrf_protectionが前提とする世代)とは共存できない
# 今回はomniauth戦略クラスをRackミドルウェアとしてではなく手動で呼び出す設計
# (後述)のため、CSRF protection gemは不要と判断し、omniauth 1.x系のまま進める
gem "omniauth", "~> 1.9"
gem "omniauth-openid-connect", "~> 0.2.3"
# 【実装時に判明】omniauth-openid-connect 0.2.3はopenid_connect ~> 0.9.2に固定依存しており、最新版(2.x系)とは同時に使えない
# そのため両gem実装とも同じopenid_connect 0.9系を使う形になる
# (「お任せ型(omniauth経由)」と「手組み型(openid_connect直接)」という利用方法の違いは
# 変わらず比較できるが、ライブラリのバージョン自体は共通、という実装上の制約としてREADMEに明記する)
gem "openid_connect", "~> 0.9.2"

# backendへのHTTP呼び出し・feature-flags/exportポーリング用
gem "faraday", "~> 2.10"

# CONTRACT.mdセクション22: パスキー(WebAuthn)
# Goのgo-webauthnに相当する定番Ruby実装
# 既存ユーザー(Keycloakでログイン済み)が追加で登録する認証手段として、bff(Go)と同じ
# backendの内部API(webauthn_credentials)を共有する
gem "webauthn", "~> 3.2"

# パスキーのみでログインしたセッションにはOIDCのaccess_tokenが存在しないため、
# bff(Go)のinternal/auth/local_jwt.go(ローカルHMAC認証)と同じ自前JWT発行を行う
# これまでomniauth-openid-connect経由の間接依存でしか入っていなかったため、
# 直接requireして使う以上、明示的にGemfileへ書く
gem "jwt", "~> 3.2"

# 【実装時に発見した実際の非互換性】json gem 3.0系はActiveSupport 8.0.5.1がまだ対応していない
# 破壊的変更(`JSON.generate`が`quirks_mode`キーワードを受け付けなくなった)を含んでおり、
# `to_json`呼び出しが`ArgumentError: unknown keyword: quirks_mode`で落ちる
# 2.x系に固定する
gem "json", "~> 2.9"

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Static analysis for security vulnerabilities [https://brakemanscanner.org/]
  gem "brakeman", require: false

  # Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
  gem "rubocop-rails-omakase", require: false
  gem "rspec-rails", "~> 7.1"
  gem "webmock", "~> 3.24"
end

group :test do
  gem "rack-test"
end
