source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.0.5", ">= 8.0.5.1"
# 【実機検証で判明】
# json gem 3.0.1はActiveSupport 8.0.5.1がまだ依存している
# `JSON.generate(..., quirks_mode: true, ...)`のキーワード引数を廃止しており、ArgumentError (unknown keyword: quirks_mode) で
# button_to等の描画が全滅する
# ActiveSupport 側の追従を待たず、後方互換のある json 2.x 系に固定して回避する
gem "json", "~> 2.21"
# The modern asset pipeline for Rails [https://github.com/rails/propshaft]
gem "propshaft"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"
# Use JavaScript with ESM import maps [https://github.com/rails/importmap-rails]
gem "importmap-rails"
# Use Redis adapter to run Action Cable in production
# gem "redis", ">= 4.0.1"

# Use Active Model has_secure_password [https://guides.rubyonrails.org/active_model_basics.html#securepassword]
# gem "bcrypt", "~> 3.1.7"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Add HTTP asset caching/compression and X-Sendfile acceleration to Puma [https://github.com/basecamp/thruster/]
gem "thruster", require: false

# CONTRACT.md: frontend-railsはbffを経由せず、Rails自身がOIDCクライアントとして
# KeycloakとAuthorization Codeフローを直接行う(bff-ginパターンとの比較実装)
gem "omniauth", "~> 2.1"
# 旧名omniauth-openid-connect(ハイフン)はomniauth 1.x系までしか対応せず更新停止済み
# 現行のOmniAuth Org管理下ではomniauth_openid_connect(アンダースコア)としてomniauth 2.x対応で
# メンテされている(gitlab-omniauth-openid-connectはその前段階のフォークで、現在は非推奨)
gem "omniauth_openid_connect", "~> 0.8"
# omniauth 2.xはrequest phaseがPOST必須になり、Railsの標準CSRF保護に
# 素で引っかかるため、omniauthのCSRFトークンチェックを橋渡しするこのgemが要る
gem "omniauth-rails_csrf_protection", "~> 1.0"

# CONTRACT.mdセクション22.9: パスキー(WebAuthn)。backend(Go)のgo-webauthnに相当する定番Ruby実装
# (bff-railsと同一のgem・同一バージョン、backendの内部API(webauthn_credentials)を共有する)
gem "webauthn", "~> 3.2"
# backendのJITプロビジョニング/webauthn登録APIをHTTPで呼ぶために使う(bff-railsと同じ)
gem "faraday", "~> 2.10"
# パスキーのみでログインしたセッション用に、bff(Go)/bff-railsと同じ自前JWT(iss=bff-gin-local-hmac)を発行する
gem "jwt", "~> 3.2"

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Static analysis for security vulnerabilities [https://brakemanscanner.org/]
  gem "brakeman", require: false

  gem "rspec-rails", "~> 7.1"
end

group :test do
  gem "webmock", "~> 3.3"
end

group :development do
  # Use console on exceptions pages [https://github.com/rails/web-console]
  gem "web-console"
end
