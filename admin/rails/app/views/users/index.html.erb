<h1>ユーザー一覧</h1>
<p class="text-muted">
  Keycloak経由のユーザーは初回ログイン時に自動作成されるためここには表示されない
  (CONTRACT.mdセクション10のJITプロビジョニング)。ここで新規作成できるのはローカル認証
  (<code>/login</code> / <code>/login/rsa</code>)でログインするユーザーのみ。
</p>

<div class="table-responsive">
  <table class="table table-striped table-bordered table-hover">
    <thead>
      <tr>
        <th>id</th>
        <th>name</th>
        <th>email</th>
        <th>パスキー</th>
        <th>role</th>
        <th colspan="2"></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user[:id] %></td>
          <td><%= user[:name] %></td>
          <td><%= user[:email] %></td>
          <td>
            <% if user[:has_passkey] %>
              <span class="text-success">✅ 登録済み</span>
            <% else %>
              <span class="text-muted">未登録</span>
            <% end %>
          </td>
          <td>
            <%= form_with(url: update_role_user_path(user[:id]), method: :patch, local: true, class: "form-inline") do |form| %>
              <%= form.select :role, [["general", "general"], ["management", "management"]], { selected: user[:role] }, class: "form-control form-control-sm mr-2" %>
              <%= form.submit "変更", class: "btn btn-sm btn-primary" %>
            <% end %>
          </td>
          <td>
            <%# このアプリはTurbo/rails-ujsを導入していないため(feature_flags画面と同じ
                最小構成)、確認ダイアログはフレームワーク非依存のonsubmitで実装する %>
            <%= button_to "削除", user_path(user[:id]), method: :delete, class: "btn btn-sm btn-outline-danger",
                  form: { onsubmit: "return confirm('本当に削除しますか?')" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<h2 class="mt-4">新規作成(ローカル認証ユーザー)</h2>

<%= form_with(url: users_path, method: :post, local: true) do |form| %>
  <div class="form-group">
    <%= form.label :name, "name" %>
    <%= form.text_field :name, class: "form-control", required: true %>
  </div>
  <div class="form-group">
    <%= form.label :email, "email" %>
    <%= form.email_field :email, class: "form-control", required: true %>
  </div>
  <div class="form-group">
    <%= form.label :password, "初期パスワード" %>
    <%= form.password_field :password, class: "form-control", required: true %>
  </div>
  <div class="form-group">
    <%= form.label :role, "role" %>
    <%= form.select :role, [["general", "general"], ["management", "management"]], {}, class: "form-control" %>
  </div>
  <%= form.submit "作成", class: "btn btn-primary" %>
<% end %>

<div class="mt-3">
  <%= link_to "一覧に戻る", root_path, class: "btn btn-secondary" %>
</div>
