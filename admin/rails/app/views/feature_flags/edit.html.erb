<h1>Feature Flag 編集: <code><%= @feature_flag.flag_key %></code></h1>
<p class="text-muted"><%= @feature_flag.description %></p>

<%= form_with(model: @feature_flag, url: feature_flag_path(@feature_flag), method: :patch, local: true) do |form| %>
  <% if @feature_flag.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% @feature_flag.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :enabled, "有効" %><br>
    <%= form.check_box :enabled, class: "form-check-input" %>
    <small class="form-text text-muted">チェックを外すとGO Feature Flagの disable: true 相当になり、常にoffとして評価される</small>
  </div>

  <div class="form-group">
    <% if @feature_flag.boolean_toggle? %>
      <%= form.label :default_variation, "既定値(on/off)" %>
    <% else %>
      <%# CONTRACT.mdセクション19.6: on/off二値以外(多値フラグ)は、variationsのキー一覧から
          選ぶ汎用selectで描画する。このフラグ専用のハードコードされた画面は用意しない %>
      <%= form.label :default_variation, "既定値" %>
    <% end %>
    <%= form.select :default_variation, @feature_flag.variation_options, {}, class: "form-control" %>
  </div>

  <div class="btn-group">
    <%= form.submit "保存", class: "btn btn-default btn-primary" %>
  </div>
<% end %>

<div class="mt-3">
  <%= link_to "一覧に戻る", root_path, class: "btn btn-secondary" %>
  <%= link_to "変更履歴", audit_logs_feature_flag_path(@feature_flag), class: "btn btn-secondary" %>
</div>
